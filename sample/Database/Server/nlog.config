<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target xsi:type="Console" name="console"
            layout="${date:format=HH\:mm\:ss} ${level:uppercase=true} ${message}${onexception:inner= ${exception}}" />
  </targets>

  <rules>
    <!-- The addresses that the server listens on, then the warnings and errors of ASP.NET Core, and the
         messages of the server from Info up. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console" final="true" />
    <logger name="Microsoft.*" finalMinLevel="Warn" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
