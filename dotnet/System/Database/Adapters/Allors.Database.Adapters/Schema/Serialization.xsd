<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="allors">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="population">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="objects">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="database">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ot" maxOccurs="unbounded" minOccurs="0">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:string">
                                  <xs:attribute type="xs:string" name="i" use="optional"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="relations">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="database">
                      <xs:complexType>
                        <xs:choice maxOccurs="unbounded" minOccurs="0">
                          <xs:element name="rtu">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="r" maxOccurs="unbounded" minOccurs="0">
                                  <xs:complexType>
                                    <xs:simpleContent>
                                      <xs:extension base="xs:string">
                                        <xs:attribute type="xs:byte" name="a" use="optional"/>
                                      </xs:extension>
                                    </xs:simpleContent>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute type="xs:string" name="i"/>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="rtc">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="r">
                                  <xs:complexType>
                                    <xs:simpleContent>
                                      <xs:extension base="xs:string">
                                        <xs:attribute type="xs:byte" name="a" use="optional"/>
                                      </xs:extension>
                                    </xs:simpleContent>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute type="xs:string" name="i" use="optional"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute type="xs:byte" name="version">
              <xs:annotation>
                <xs:documentation>
                  1: ambiguous. String unit roles are raw xml text in populations saved before
                  2023-07-05 and Base64 encoded in populations saved after. Both declare version 1,
                  so the encoding has to be supplied by the caller when loading.
                  2: string unit roles are always the Base64 representation of their UTF-8 bytes.
                </xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>