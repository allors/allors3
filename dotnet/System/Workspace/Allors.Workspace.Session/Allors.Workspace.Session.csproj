  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Allors.Shared.csproj" />
    <ProjectReference Include="..\Allors.Workspace.Connection\Allors.Workspace.Connection.csproj" />
    <ProjectReference Include="..\Allors.Workspace.Domain\Allors.Workspace.Domain.csproj" />
    <ProjectReference Include="..\Allors.Workspace.Meta\Allors.Workspace.Meta.csproj" />
  </ItemGroup>

</Project>
