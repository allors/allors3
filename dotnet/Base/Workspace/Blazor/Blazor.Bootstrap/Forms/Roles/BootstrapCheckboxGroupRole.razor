@inherits ABSCheckboxGroupBase

<BSInputGroup @attributes="Attributes">

    @foreach (var option in Options)
    {
        <BSInputGroup IsCheck="true">
            <BSInputCheckbox TValue="bool" Id="@OptionName(option)"
                             CheckedValue="true" UnCheckedValue="false"
                             Value="@IsSelected(option)"
                             ValueChanged="@(v => OnChanged(v, option))" />
            <BSLabel For="@OptionName(option)">@(DisplayOption(option))</BSLabel>
        </BSInputGroup>
    }
</BSInputGroup>
